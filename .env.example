# Local stdio mode requires no secrets.

# Optional authenticated Streamable HTTP mode:
# CLOUD_DEVOPS_MCP_BEARER_TOKEN=replace-with-a-random-secret-at-least-32-characters
# CLOUD_DEVOPS_MCP_HOST=127.0.0.1
# CLOUD_DEVOPS_MCP_PORT=3000

# Required for non-local HTTP binding:
# CLOUD_DEVOPS_MCP_ALLOWED_HOSTS=mcp.example.com
# CLOUD_DEVOPS_MCP_ALLOWED_ORIGINS=mcp.example.com
# CLOUD_DEVOPS_MCP_PUBLIC_BASE_URL=https://mcp.example.com

# Analysis tools do not require cloud-provider credentials.

# Optional controlled Git/GitHub execution (disabled by default):
# CLOUD_DEVOPS_MCP_EXECUTION_ENABLED=true
# CLOUD_DEVOPS_MCP_ALLOWED_REPOSITORIES=C:\path\to\repo
# CLOUD_DEVOPS_MCP_PROTECTED_BRANCHES=main,master,production,prod,release
# CLOUD_DEVOPS_MCP_ALLOWED_BRANCH_PREFIXES=feature/,feat/,fix/,chore/,docs/,test/
# CLOUD_DEVOPS_MCP_ALLOWED_REMOTES=origin
# CLOUD_DEVOPS_MCP_ALLOWED_GITHUB_REPOSITORIES=owner/repo
# CLOUD_DEVOPS_MCP_GITHUB_TOKEN=github_pat_replace_me
# CLOUD_DEVOPS_MCP_ALLOWED_WORKFLOWS=ci.yml,release.yml
# CLOUD_DEVOPS_MCP_AUDIT_LOG=C:\secure\cloud-devops-mcp-audit.jsonl
