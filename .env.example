# Local stdio mode requires no secrets.

# Optional authenticated Streamable HTTP mode:
# CLOUD_DEVOPS_MCP_BEARER_TOKEN=replace-with-a-random-secret-at-least-32-characters
# CLOUD_DEVOPS_MCP_HOST=127.0.0.1
# CLOUD_DEVOPS_MCP_PORT=3000

# Required for non-local HTTP binding:
# CLOUD_DEVOPS_MCP_ALLOWED_HOSTS=mcp.example.com
# CLOUD_DEVOPS_MCP_ALLOWED_ORIGINS=mcp.example.com
# CLOUD_DEVOPS_MCP_PUBLIC_BASE_URL=https://mcp.example.com

# Analysis tools do not require cloud-provider credentials.

# Optional controlled Git/GitHub execution (disabled by default):
# CLOUD_DEVOPS_MCP_EXECUTION_ENABLED=true
# CLOUD_DEVOPS_MCP_ALLOWED_REPOSITORIES=C:\path\to\repo
# CLOUD_DEVOPS_MCP_PROTECTED_BRANCHES=main,master,production,prod,release
# CLOUD_DEVOPS_MCP_ALLOWED_BRANCH_PREFIXES=feature/,feat/,fix/,chore/,docs/,test/
# CLOUD_DEVOPS_MCP_ALLOWED_REMOTES=origin
# CLOUD_DEVOPS_MCP_ALLOWED_GITHUB_REPOSITORIES=owner/repo
# CLOUD_DEVOPS_MCP_GITHUB_TOKEN=replace-with-github-token
# CLOUD_DEVOPS_MCP_ALLOWED_WORKFLOWS=ci.yml,release.yml
# CLOUD_DEVOPS_MCP_AUDIT_LOG=C:\secure\cloud-devops-mcp-audit.jsonl

# Optional Terraform/Kubernetes operations (disabled by default):
# CLOUD_DEVOPS_MCP_INFRASTRUCTURE_OPERATIONS_ENABLED=true
# CLOUD_DEVOPS_MCP_ALLOWED_KUBE_CONTEXTS=dev-cluster,prod-cluster
# CLOUD_DEVOPS_MCP_ALLOWED_KUBE_NAMESPACES=default,platform
# CLOUD_DEVOPS_MCP_ALLOWED_KUBE_RESOURCES=pods,deployments,statefulsets,daemonsets,services,ingresses,jobs,cronjobs,namespaces,nodes

# Optional live multi-cloud inventory and observability (disabled by default):
# Uses the locally configured AWS CLI, Azure CLI and/or gcloud credentials.
# CLOUD_DEVOPS_MCP_CLOUD_INVENTORY_ENABLED=true
# CLOUD_DEVOPS_MCP_ALLOWED_AWS_ACCOUNTS=123456789012
# CLOUD_DEVOPS_MCP_ALLOWED_AWS_REGIONS=ca-central-1,us-east-1
# CLOUD_DEVOPS_MCP_ALLOWED_AWS_PROFILES=dev,prod-readonly
# CLOUD_DEVOPS_MCP_ALLOWED_AZURE_SUBSCRIPTIONS=00000000-0000-0000-0000-000000000000
# CLOUD_DEVOPS_MCP_ALLOWED_GCP_PROJECTS=my-project-id

# Optional production observability intelligence (v0.8)
CLOUD_DEVOPS_MCP_OBSERVABILITY_ENABLED=false
CLOUD_DEVOPS_MCP_ALLOWED_PROMETHEUS_URLS=
CLOUD_DEVOPS_MCP_PROMETHEUS_BEARER_TOKEN=
CLOUD_DEVOPS_MCP_ALLOWED_GRAFANA_URLS=
CLOUD_DEVOPS_MCP_GRAFANA_TOKEN=
CLOUD_DEVOPS_MCP_ALLOWED_CLOUDWATCH_LOG_GROUPS=

# Optional distributed tracing and SLO intelligence (v0.9)
CLOUD_DEVOPS_MCP_TRACING_ENABLED=false
CLOUD_DEVOPS_MCP_ALLOWED_TEMPO_URLS=
CLOUD_DEVOPS_MCP_TEMPO_BEARER_TOKEN=
CLOUD_DEVOPS_MCP_ALLOWED_JAEGER_URLS=
CLOUD_DEVOPS_MCP_JAEGER_BEARER_TOKEN=

# Optional OpsChugex commercial root-cause intelligence (v0.10)
CLOUD_DEVOPS_MCP_OPSCHUGEX_INTELLIGENCE_ENABLED=false
CLOUD_DEVOPS_MCP_OPSCHUGEX_ROOT_CAUSE_URL=https://api.opschugex.com/v1/root-cause/diagnose
CLOUD_DEVOPS_MCP_OPSCHUGEX_TOKEN=

# Optional OpsChugex policy and governance intelligence (v0.11)
CLOUD_DEVOPS_MCP_OPSCHUGEX_GOVERNANCE_ENABLED=false
CLOUD_DEVOPS_MCP_OPSCHUGEX_GOVERNANCE_URL=https://api.opschugex.com/v1/governance/assess

# Optional OpsChugex cloud security posture intelligence (v0.12)
CLOUD_DEVOPS_MCP_OPSCHUGEX_SECURITY_ENABLED=false
CLOUD_DEVOPS_MCP_OPSCHUGEX_SECURITY_URL=https://api.opschugex.com/v1/security/posture
