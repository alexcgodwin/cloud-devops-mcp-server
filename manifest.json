{
  "name": "Cloud DevOps MCP Server",
  "slug": "cloud-devops-mcp-server",
  "version": "0.6.0",
  "description": "MCP v2 server for Cloud DevOps analysis plus opt-in controlled Git/GitHub, Terraform and Kubernetes operations.",
  "author": {
    "name": "Alex C. Godwin",
    "url": "https://github.com/alexcgodwin"
  },
  "repository": "https://github.com/alexcgodwin/cloud-devops-mcp-server",
  "license": "MIT",
  "runtime": {
    "type": "node",
    "node": ">=20",
    "defaultTransport": "stdio",
    "command": "node",
    "args": ["dist/index.js"],
    "optionalTransport": {
      "type": "streamable-http",
      "args": ["dist/index.js", "--http"],
      "authentication": "bearer",
      "remoteTlsRequired": true
    }
  },
  "capabilities": {
    "protocol": "2026-07-28",
    "structuredContent": true,
    "readOnlyByDefault": true,
    "controlledExecution": true,
    "infrastructureOperations": true,
    "terraformApply": false,
    "kubernetesMutation": false,
    "crossDomainCorrelation": true,
    "multiCloudIdentityPolicyPacks": ["aws", "azure", "gcp"],
    "supplyChainAnalysis": true,
    "authenticatedStreamableHttp": true,
    "artifactParsing": [
      "terraform-plan-json",
      "iam-policy-json",
      "azure-rbac-json",
      "gcp-iam-json",
      "kubernetes-yaml",
      "github-actions-yaml",
      "cyclonedx-json",
      "spdx-json"
    ]
  },
  "tools": [
    {"name": "assess_cloud_change_bundle", "category": "cross-domain-risk"},
    {"name": "assess_terraform_change", "category": "infrastructure-risk"},
    {"name": "build_incident_runbook", "category": "incident-response"},
    {"name": "review_cicd_pipeline", "category": "delivery-readiness"},
    {"name": "estimate_slo_error_budget", "category": "sre"},
    {"name": "review_iam_policy", "category": "cloud-security"},
    {"name": "review_kubernetes_deployment", "category": "kubernetes"},
    {"name": "review_github_actions_workflow", "category": "ci-cd-security"},
    {"name": "review_cloud_identity_policy", "category": "multi-cloud-identity"},
    {"name": "review_terraform_security", "category": "terraform-security"},
    {"name": "review_kubernetes_security", "category": "kubernetes-security"},
    {"name": "review_software_supply_chain", "category": "software-supply-chain"}
  ]
}
