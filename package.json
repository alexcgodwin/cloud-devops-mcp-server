{
  "name": "cloud-devops-mcp-server",
  "version": "0.1.0",
  "description": "A Model Context Protocol server for Cloud DevOps engineering analysis, incident runbooks, CI/CD readiness and SLO calculations.",
  "type": "module",
  "mcpName": "com.alexcgodwin/cloud-devops-mcp-server",
  "bin": {
    "cloud-devops-mcp-server": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "check": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cloud",
    "devops",
    "sre",
    "terraform",
    "kubernetes",
    "incident-response",
    "ci-cd"
  ],
  "author": "Alex C. Godwin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexcgodwin/cloud-devops-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/alexcgodwin/cloud-devops-mcp-server/issues"
  },
  "homepage": "https://github.com/alexcgodwin/cloud-devops-mcp-server#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
