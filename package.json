{
  "name": "cloud-devops-mcp-server",
  "version": "0.2.1",
  "description": "A Model Context Protocol server for Cloud DevOps engineering analysis, incident runbooks, CI/CD readiness and SLO calculations.",
  "type": "module",
  "mcpName": "io.github.alexcgodwin/cloud-devops-mcp-server",
  "bin": {
    "cloud-devops-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json",
    "manifest.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "check": "npm run build && npm run test:coverage && npm audit --omit=dev --audit-level=high",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cloud",
    "devops",
    "sre",
    "terraform",
    "kubernetes",
    "incident-response",
    "ci-cd"
  ],
  "author": "Alex C. Godwin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexcgodwin/cloud-devops-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/alexcgodwin/cloud-devops-mcp-server/issues"
  },
  "homepage": "https://github.com/alexcgodwin/cloud-devops-mcp-server#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.2.0",
    "yaml": "^2.9.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^5.0.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^5.0.3"
  }
}
